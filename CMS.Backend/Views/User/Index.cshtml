@{
    Layout = "_LayoutAdmin";
}
@model IEnumerable<CMS.Data.Entities.User>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold text-uppercase m-0" style="letter-spacing: 0.5px;">Danh Sách Thành Viên</h2>
        <a href="/User/Create" class="btn btn-success px-3 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm thành viên mới
        </a>
    </div>

    <div class="row g-4">
        @foreach (var user in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm user-card">
                    <div class="card-body p-4 d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="bg-light p-2 rounded-3 text-center" style="width: 50px; height: 50px;">
                                <i class="bi bi-person-circle text-secondary fs-2"></i>
                            </div>

                            @if (user.Role == "Admin" || user.Role == "Administrator")
                            {
                                <span class="badge bg-danger px-2 py-1 text-uppercase">@user.Role</span>
                            }
                            else if (user.Role == "Editor")
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 text-uppercase">@user.Role</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark px-2 py-1 text-uppercase">@user.Role</span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-1">@user.FullName</h5>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-shield-lock me-1"></i> Tài khoản: <span class="fw-bold text-primary">@user.Username</span>
                        </p>

                        <div class="bg-light p-2 rounded mb-4 small text-secondary border-start border-3 border-secondary">
                            <i class="bi bi-key-fill me-1"></i> Mật khẩu: <code>@user.PasswordHash</code>
                        </div>

                        <div class="d-flex gap-2 mt-auto pt-2 border-top">
                            <a href="/User/Edit/@user.Id" class="btn btn-sm btn-outline-warning text-dark fw-bold flex-grow-1">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a href="/User/Delete/@user.Id" class="btn btn-sm btn-outline-danger flex-grow-1">
                                <i class="bi bi-trash3"></i> Xóa
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .user-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .user-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>