@model CMS.Data.Entities.User

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 text-uppercase fw-bold text-center">Chỉnh Sửa Thành Viên</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tài khoản (Username):</label>
                    <input asp-for="Username" class="form-control" readonly style="background-color: #e9ecef;" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Mật khẩu mới (Nếu muốn đổi):</label>
                    <input asp-for="PasswordHash" type="text" class="form-control" placeholder="Để trống nếu muốn giữ nguyên mật khẩu cũ" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Họ và Tên (FullName):</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Vai trò hệ thống (Role):</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Admin">Admin</option>
                        <option value="Editor">Editor</option>
                        <option value="User">User</option>
                        <option value="Moderator">Moderator</option>
                    </select>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>