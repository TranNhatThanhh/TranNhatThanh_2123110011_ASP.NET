@model CMS.Data.Entities.Category

<div class="container mt-4">
    <div class="alert alert-danger">
        <h4 class="fw-bold mb-1">CẢNH BÁO XÁC NHẬN XÓA!</h4>
        Bạn có chắc chắn muốn xóa danh mục này ra khỏi hệ thống cơ sở dữ liệu không? Hành động này không thể hoàn tác!
    </div>
    <hr />

    <div class="card p-3 bg-light">
        <p class="mb-2"><strong>Mã số danh mục (ID):</strong> @Model.Id</p>
        <p class="mb-2"><strong>Tên danh mục:</strong> @Model.Name</p>
        <p class="mb-0"><strong>Mô tả chi tiết:</strong> @Model.Description</p>
    </div>

    <form asp-action="Delete" method="post" class="mt-4">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger px-4">Xác nhận xóa hẳn</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy, quay lại</a>
    </form>
</div>