@model IEnumerable<CMS.Data.Entities.Post>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 text-uppercase fw-bold text-dark" style="letter-spacing: 0.5px;">Quản Lý Bài Viết</h2>
        <a href="/Post/Create" class="btn btn-success px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Viết bài mới
        </a>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">Chưa có bài viết nào trong danh mục này hoặc hệ thống trống.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm post-card d-flex flex-column">
                        <div class="position-relative" style="height: 200px; overflow: hidden;">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/default.jpg" : item.ImageUrl)"
                                 class="card-img-top h-100 w-100 object-fit-cover"
                                 alt="Thumbnail"
                                 style="object-fit: cover;">
                        </div>

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <div class="mb-2">
                                <span class="badge bg-info text-dark px-2 py-1 text-uppercase small fw-bold">
                                    <i class="bi bi-tag-fill me-1"></i>@(item.Category != null ? item.Category.Name : "Chưa phân loại")
                                </span>
                            </div>

                            <h5 class="card-title text-primary fw-bold text-truncate-2" style="height: 48px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Title
                            </h5>

                            <p class="card-text text-muted small mb-3 text-truncate" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @item.Content
                            </p>

                            <div class="text-secondary small mb-4 mt-auto">
                                <i class="bi bi-calendar3 me-1"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </div>

                            <div class="d-flex gap-2 pt-2 border-top">
                                <a href="/Post/Details/@item.Id" class="btn btn-sm btn-outline-primary fw-bold flex-grow-1" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i> Xem
                                </a>
                                <a href="/Post/Edit/@item.Id" class="btn btn-sm btn-outline-warning text-dark fw-bold flex-grow-1" title="Sửa bài viết">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <a href="/Post/Delete/@item.Id" class="btn btn-sm btn-outline-danger flex-grow-1" title="Xóa bài viết">
                                    <i class="bi bi-trash3"></i> Xóa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .post-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .post-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.15) !important;
        }
</style>