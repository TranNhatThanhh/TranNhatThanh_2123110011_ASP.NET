@model CMS.Data.Entities.Post

<div class="container mt-4" style="max-width: 750px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 text-uppercase fw-bold text-center">Chỉnh Sửa Bài Viết</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Tiêu đề bài viết:</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Chuyên mục bài viết:</label>
                    <select asp-for="CategoryId" class="form-select" required>
                        @foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Đường dẫn hình ảnh:</label>
                    <input asp-for="ImageUrl" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nội dung bài viết:</label>
                    <textarea asp-for="Content" class="form-control" rows="8" required></textarea>
                </div>

                <div class="d-flex gap-2 justify-content-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-3">Hủy bỏ</a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-4">Cập nhật bài viết</button>
                </div>
            </form>
        </div>
    </div>
</div>